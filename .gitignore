# The frontend and backend are their own GitHub repos.
lovemesomecoding_backend
lovemesomecoding_backend/**

lovemesomecoding_frontend
lovemesomecoding_frontend/**

node_modules
node_modules/**

/leetcode
/leetcode/**

lovemesomecoding_demo_project
lovemesomecoding_demo_project/**

# ---------------------------------------------------------------
# Migration artifacts — all regenerable, none belong in git.
#   raw/  is re-fetchable with fetch_wp.py
#   out/db    is the content database, source of truth lives in S3
#   out/media is 47 MB of images, already in the storage bucket
# ---------------------------------------------------------------
projects/rewrite/migration/raw/
projects/rewrite/migration/out/

# Logs must never be committed.
*.log

# Python build output. The projects/ tooling is run in place, so these appear
# next to the scripts; six of them are currently tracked and want removing with
# `git rm -r --cached projects/*/__pycache__`.
__pycache__/
*.pyc
.venv/
