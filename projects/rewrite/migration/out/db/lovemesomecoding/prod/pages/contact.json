{"slug":"contact","wpId":4192,"title":"Contact","url":"/contact","date":"2020-05-21T21:49:15","modified":"2020-05-23T17:07:07","contentHtml":"<br/>\n<h1 class=\"text-center\">Contact Us</h1>\n<p><iframe aria-label=\"Lehi, Utah\" frameborder=\"0\" height=\"450\" src=\"https://maps.google.com/maps?q=Lehi%2C%20Utah&amp;t=m&amp;z=11&amp;output=embed&amp;iwloc=near\" style=\"border:0\" width=\"100%\"></iframe> </p>\n<div class=\"row\">\n<div class=\"col-sm-8\">\n<form>\n<div class=\"row\">\n<div class=\"col-sm-6\">\n<div class=\"form-group\">\n<label for=\"yourName\">Name</label><br/>\n<input aria-describedby=\"yourName\" class=\"form-control\" id=\"yourName\" placeholder=\"Your name\" type=\"text\"/>\n</div>\n</div>\n<div class=\"col-sm-6\">\n<div class=\"form-group\">\n<label for=\"yourEmail\">Email</label><br/>\n<input aria-describedby=\"yourEmail\" class=\"form-control\" id=\"yourEmail\" placeholder=\"Your email\" type=\"email\"/>\n</div>\n</div>\n</div>\n<div class=\"row\">\n<div class=\"col-sm-12\">\n<div class=\"form-group\">\n<label for=\"yourMsg\">Message</label><br/>\n<textarea class=\"form-control\" id=\"yourMsg\" rows=\"3\"></textarea>\n</div>\n</div>\n</div>\n<div class=\"row\">\n<div class=\"col-sm-12\">\n<button class=\"btn btn-primary\" id=\"submitBtn\" type=\"button\">Submit</button>\n</div>\n</div>\n</form>\n</div>\n<div class=\"col-sm-4\">\n<div class=\"card\">\n<div class=\"card-body\">\n<h5 class=\"card-title\">Address</h5>\n<p class=\"card-text\">Lehi, Utah</p>\n</div>\n<div class=\"card-body\">\n<h5 class=\"card-title\">Email</h5>\n<p class=\"card-text\">folaudev@gmail.com</p>\n</div>\n</div>\n</div>\n</div>\n<div id=\"msgSentConfirmation\" style=\"display:none;\" title=\"Message sent!\">\n<p>I will get back to you soon.</p>\n</div>\n","toc":[],"status":"published"}